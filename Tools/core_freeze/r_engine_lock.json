    "RcppEigen": "0.3.4.0.2",
    "minqa": "1.2.8",
    "nloptr": "2.2.1",
    "Rdpack": "2.6.6",
    "reformulas": "0.4.4",
    "estimability": "2.0.0",
    "mvtnorm": "1.4.2",
